rtyList[].name": ["sharedassets111.assets"]}, "Directional Light Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Directional Light Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Environment Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Environment Ambient Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Environment Equator Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Environment Ground  Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Light Rain Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Medium Rain Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Heavy Rain Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Snow Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Rain Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Snow Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Light Rain Sound Fx": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Medium Rain Sound Fx": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Heavy Rain Sound Fx": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Light Wind Sound Fx": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Medium Wind Sound Fx": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Heavy Wind Sound Fx": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "WindSpeed": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Wind Direction": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Sun Texture Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Moon Texture Intensity": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Directional Light Strength": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Static Cloud Scattering": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Static Cloud Color": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Temperature": {"AzureWeatherProfile:profilePropertyList[].name": ["sharedassets111.assets"]}, "Assets/Content/Notes/Mines/SNW_dumping_tunnel.asset": {"NoteInfo:addressableAssetPath": ["sharedassets111.assets"]}, "Dumping Tunnel Warning": {"NoteInfo:title": ["sharedassets111.assets"]}, "One of the spent fuel casks in the dumping tunnel have fallen and its lid has broken open spilling its contents. Now that tunnel is deadly radioactive. Even mere minutes in it are enough for a fatal dose, and you wouldn't feel anything! \n\nDon't go past the fence, or you will be a dead man walking!": {"NoteInfo:content": ["sharedassets111.assets"]}, "Assets/Content/Notes/Mines/SNW_dumping_tunnel_note.asset": {"NoteInfo:addressableAssetPath": ["sharedassets111.assets"]}, "Dumping Tunnel Blast Door Note": {"NoteInfo:title": ["sharedassets111.assets"]}, "Notice!\n\nThis door is wired to radiation measurement devices.\nThe door cannot be opened if radiation exceeds 50 millisieverts per hour.\nThe radiation measurement devices must be powered for the door to function properly. Ensure they are operational before attempting access.": {"NoteInfo:content": ["sharedassets111.assets"]}, "Assets/Content/Notes/Mines/SNW_dumping_tunnel_wagon_note.asset": {"NoteInfo:addressableAssetPath": ["sharedassets111.assets"]}, "Nuclear Fuel Wagon": {"NoteInfo:title": ["sharedassets111.assets"]}, "Nuclear Fuel Wagon – Overview\n\nA nuclear fuel wagon is designed to safely transport nuclear fuel, featuring multiple layers of shielding to prevent radiation exposure. It is equipped with a heavy-duty, radiation-shielded container, typically made of steel and lead, to block radiation.\n\nThese wagons are essential for transporting fuel between nuclear power plants, reprocessing facilities, and storage sites. Proper handling and monitoring ensure minimal risk to workers, the public, and the environment.": {"NoteInfo:content": ["sharedassets111.assets"]}, "Assets/Content/Notes/Mines/oredrop_note.asset": {"NoteInfo:addressableAssetPath": ["sharedassets111.assets"]}, "Ore drop-off note": {"NoteInfo:title": ["sharedassets111.assets"]}, "Notice Miners!\n\n- A valid mining permit is required for dropping off ore.\n\n- If you don't have a mining permit, speak to Reijo at the office building.\n\n- Receipts can be cashed at the office building.": {"NoteInfo:content": ["sharedassets111.assets"]}, "Assets/Content/Notes/Newspaper/Safety Concerns Escalate Over SOMC Mining in Obenseuer.asset": {"NoteInfo:addressableAssetPath": ["sharedassets111.assets"]}, "Safety Concerns Escalate Over SOMC Mining in Obenseuer ": {"NoteInfo:title": ["sharedassets111.assets"]}, "Stalburg Times\r\nTuesday, October 15th, 2019\r\n\r\nSafety Concerns Escalate Over SOMC Mining in Obenseuer\r\n\r\nResidents of Obenseuer, a district in Stalburg already grappling with a well-known quarantine zone due to a persistent fungal disease, are now raising alarms over active mining operations by the Stalburg-Obenseuer Mining Company (SOMC). After mining the primary vein to exhaustion, SOMC has moved its activity farther from central Obenseuer. However, the company’s interest in side veins beneath the settlement has raised fears of dangerous collapses similar to those seen in the area’s older, abandoned mines.\r\n\r\nAdding to residents' unease, an independent mining venture started by a local resident has been rapidly expanding. Originally a small operation, this project has grown in size, raising questions about safety and the potential structural risks to surrounding areas.\r\n\r\nIn response to community concerns, SOMC’s project director, Karl Hentzel, has attempted to reassure the public. “SOMC is committed to safe and responsible mining practices,” Hentzel stated. “We’ve conducted thorough studies and applied advanced engineering measures to ensure the stability of our tunnels. Our team has carefully considered past mining issues and put in place modern safeguards to prevent similar incidents.”\r\n\r\nHowever, local trust in SOMC has been further strained by a recent, mysterious accident involving company miners. SOMC has released few details about the incident, fueling public suspicion. Chief Inspector Jorma Kaisto of the Stalburg Police has publicly accused SOMC of obstructing the investigation, alleging that the company may be attempting to withhold evidence.\r\n\r\n“Our focus is the safety of Obenseuer residents, and we expect SOMC to fully cooperate,” Kaisto stated. “Any attempt to obstruct this investigation will be met with serious consequences.”\r\n\r\nWith concerns mounting over both SOMC’s operations and the expanding independent mining project, Obenseuer’s residents face a growing sense of uncertainty and frustration in a district already under strain.": {"NoteInfo:content": ["sharedassets111.assets"]}, "Assets/Content/Prefabs/Building System/Furniture/Shop Lists/lab_list.asset": {"FurnitureShopItemsList:addressableAssetPath": ["sharedassets111.assets"]}, "Assets/Content/Prefabs/Building System/Furniture/Shop Lists/mining_services_list_clutter_001.asset": {"FurnitureShopItemsList:addressableAssetPath": ["sharedassets111.assets"]}, "Assets/Content/Prefabs/Building System/Furniture/Shop Lists/mining_services_list_machinery_001.asset": {"FurnitureShopItemsList:addressableAssetPath": ["sharedassets111.assets"]}, "Assets/Content/Prefabs/Vehicles/Fla