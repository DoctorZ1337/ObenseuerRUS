    {"id": "dlg/18/1", "kind": "dialogue", "conv": 18, "entry": 1, "source": "PERKELE\\,!\\,!\\,\\, My head!\\,\\,\\, I just\\, hate when someone\\, hits me...", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/2", "kind": "dialogue", "conv": 18, "entry": 2, "source": "Oh\\,\\,, I'm so sorry!!!!\\, Did I wake you up\\,!\\,!\\,!\\,!\\,?\\,?\\,\\,\\,\\,?\\,?\\,?\\,?\\,?\\,?\\,?\\,?", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/3", "kind": "dialogue", "conv": 18, "entry": 3, "source": "This is going to be so fun\\,!\\,\\, I know\\,!\\,!\\,\\,\\, I know\\,!\\,!\\,!\\,\\,\\, You look so\\,.\\,.\\,.", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/4", "kind": "dialogue", "conv": 18, "entry": 4, "source": "So...\\,\\, grim\\,?\\,\\, What's wrong\\,?\\,\\, You know where we are going to\\,?", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/6", "kind": "dialogue", "conv": 18, "entry": 6, "source": "I heard that\\, you get the best shrooms\\, from there\\,!\\,\\,\\, I can't wait\\,!\\,!", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/8", "kind": "dialogue", "conv": 18, "entry": 8, "source": "So...\\,\\, you ate shrooms\\,?\\,?\\,\\, Is that why you're here\\,?\\,?\\,?", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/9", "kind": "dialogue", "conv": 18, "entry": 9, "source": "I think\\, I'm going to get some damn big house!", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/10", "kind": "dialogue", "conv": 18, "entry": 10, "source": "There might be some side effects with those shrooms\\,\\, but it's normal.\\, Heh!!", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/11", "kind": "dialogue", "conv": 18, "entry": 11, "source": "Oh come on\\,!\\,!\\,\\,\\, You should smile...\\,\\,\\, you damn turnip head\\,!", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/12", "kind": "dialogue", "conv": 18, "entry": 12, "source": "I think you did\\,!\\,\\, Haha\\,!\\,!\\,\\,\\,\\, Because you look so healthy\\,!\\,!", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
    {"id": "dlg/18/13", "kind": "dialogue", "conv": 18, "entry": 13, "source": "Maybe even one tenement that is only for me\\,!\\,!\\,!", "target": "", "status": "todo", "context": "Unused/Intro bus guy | ?"},
