    {"id": "dlg/31/1", "kind": "dialogue", "conv": 31, "entry": 1, "source": "What is bothering you?\\, Where is the ache?", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/2", "kind": "dialogue", "conv": 31, "entry": 2, "source": "*Sniff* \\, *Sniff* \\,  Do I smell\\,.\\,.\\,.\\, *Sniff* \\, TURNIP\\, in\\, you\\,!?\\,\nAAAAAAaaaaaaaAAAAAAAaaaaaaAAAAA!!!\\,\nLeave!\\, Leave!\\, Leave now!!!", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/3", "kind": "dialogue", "conv": 31, "entry": 3, "source": "I'm worried about my mental state... (Pay 130 OC)", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/4", "kind": "dialogue", "conv": 31, "entry": 4, "source": "The problem with you is\\,.\\,.\\,.\\, Poverty.\\,\nMeaning,\\,\\, you didn't pay me,\\, dammit!\n", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/5", "kind": "dialogue", "conv": 31, "entry": 5, "source": "You are fine.\\,\\,\\, There are no signs of any mental issues in you.\\,\\, You may leave these premises\\,\\,, so I can serve\\, other vermin now.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/6", "kind": "dialogue", "conv": 31, "entry": 6, "source": "Just some mild depression\\,\\,, and that sure is\\, a rare condition\\, in a depressive place like an Open Sewer.\\,\\,\\, Sleep in a comfy bed\\,\\,, eat a fine meal\\,\\,, and definitely not turnip\\s\\,\\,, and it'll go away.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/7", "kind": "dialogue", "conv": 31, "entry": 7, "source": "You have mediocre depression\\,\\,, that's common around here.\\,.\\,.\\,\\,\\, Go buy some depression medicine\\,\\,, and stay away from turnips\\,\\,, so you'll be fine.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/8", "kind": "dialogue", "conv": 31, "entry": 8, "source": "You have severe depression!\\,\\,\\, Get some depression meds now.\\,\\, or I will see you hanging from a street lamp!", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/9", "kind": "dialogue", "conv": 31, "entry": 9, "source": "I'll go fetch some money then.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/10", "kind": "dialogue", "conv": 31, "entry": 10, "source": "Alright then, you bloodsucker.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/11", "kind": "dialogue", "conv": 31, "entry": 11, "source": "Okay, thanks! ", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/12", "kind": "dialogue", "conv": 31, "entry": 12, "source": "I will, doctor!", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/13", "kind": "dialogue", "conv": 31, "entry": 13, "source": "Uh...", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/14", "kind": "dialogue", "conv": 31, "entry": 14, "source": "Every part hurts and I'm feeling weak.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/15", "kind": "dialogue", "conv": 31, "entry": 15, "source": "You got hurt?\\,\\,\\, Also...\\,\\, that sounds like one of the possible symptoms\\, of the fungal disease.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/16", "kind": "dialogue", "conv": 31, "entry": 16, "source": "Also...", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/17", "kind": "dialogue", "conv": 31, "entry": 17, "source": "Check me for the mushroom illness! (Pay 200 OC)", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/18", "kind": "dialogue", "conv": 31, "entry": 18, "source": "I got hurt or something, please patch me up. (Pay 160 OC)", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/19", "kind": "dialogue", "conv": 31, "entry": 19, "source": "Nothing too bad, just some bandage and painkillers will do. (Pay 100 OC)", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/20", "kind": "dialogue", "conv": 31, "entry": 20, "source": "Changed my mind, I'm fine!", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/21", "kind": "dialogue", "conv": 31, "entry": 21, "source": "So...\\,\\,\\, Where's the money?", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/22", "kind": "dialogue", "conv": 31, "entry": 22, "source": "This\\, should do.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/23", "kind": "dialogue", "conv": 31, "entry": 23, "source": "I thought you were doing charity?", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/24", "kind": "dialogue", "conv": 31, "entry": 24, "source": "So...\\,\\,\\, Where's the money?", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/25", "kind": "dialogue", "conv": 31, "entry": 25, "source": "So...\\,\\,\\, Where's the money?", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/26", "kind": "dialogue", "conv": 31, "entry": 26, "source": "You\\, spent all of your money on mushrooms\\,\\,\\,, and didn't leave any for me?", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/27", "kind": "dialogue", "conv": 31, "entry": 27, "source": "I don't remember...", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/28", "kind": "dialogue", "conv": 31, "entry": 28, "source": "Oh,\\, this is something extraordinary.\\,\\,\\, You are clean.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/29", "kind": "dialogue", "conv": 31, "entry": 29, "source": "Huh? I was worried for a second. Thank you!", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/30", "kind": "dialogue", "conv": 31, "entry": 30, "source": "Well,\\,\\,\\, I have good news\\,\\, and bad news...", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/31", "kind": "dialogue", "conv": 31, "entry": 31, "source": "Tell me...", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/32", "kind": "dialogue", "conv": 31, "entry": 32, "source": "Bad news are:\\, You have that fungal disease...\\,\nAnd the good news:\\, It's not active,\\, it's spreading has stopped.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/33", "kind": "dialogue", "conv": 31, "entry": 33, "source": "Is there something you could do?", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/34", "kind": "dialogue", "conv": 31, "entry": 34, "source": "Depending\\, on if you have REAL money...", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/35", "kind": "dialogue", "conv": 31, "entry": 35, "source": "There\\, isn't anything I can do...\\,\\,\\, You may leave.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/36", "kind": "dialogue", "conv": 31, "entry": 36, "source": "Okay\\,\\,\\,, are you ready to hear it?", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/37", "kind": "dialogue", "conv": 31, "entry": 37, "source": "Good to hear! ", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/38", "kind": "dialogue", "conv": 31, "entry": 38, "source": "I'm ready.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/39", "kind": "dialogue", "conv": 31, "entry": 39, "source": "You\\, will leave this place in [lua(Actor[\"Unused_Doctor\"].PlayerSMVLifetimeLeft)] days.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/40", "kind": "dialogue", "conv": 31, "entry": 40, "source": "What do you mean?", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/41", "kind": "dialogue", "conv": 31, "entry": 41, "source": "You\\,\\, will die in [lua(Actor[\"Unused_Doctor\"].PlayerSMVLifetimeLeft)] days\\,\\,\\,, stupid...", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/42", "kind": "dialogue", "conv": 31, "entry": 42, "source": "I... I... Accept my fate...", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/43", "kind": "dialogue", "conv": 31, "entry": 43, "source": "Nice.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/44", "kind": "dialogue", "conv": 31, "entry": 44, "source": "Is there something you could do?", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/45", "kind": "dialogue", "conv": 31, "entry": 45, "source": "Not now\\,\\,\\,, but once the growth becomes more visible\\,\\,\\,, I could surgigally remove them giving you extra time.\\,\\,\\, For a hefty price...", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/46", "kind": "dialogue", "conv": 31, "entry": 46, "source": "I'll be back then.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/47", "kind": "dialogue", "conv": 31, "entry": 47, "source": "You\\, have.\\,.\\,.\\, [lua(Actor[\"Unused_Doctor\"].PlayerSMVLifetimeLeft)]\\, days\\, of \\,lifetime\\, left!", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/48", "kind": "dialogue", "conv": 31, "entry": 48, "source": "I do.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/49", "kind": "dialogue", "conv": 31, "entry": 49, "source": "Do I look like I do?", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/50", "kind": "dialogue", "conv": 31, "entry": 50, "source": "Then\\,\\, there is nothing I can do.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/51", "kind": "dialogue", "conv": 31, "entry": 51, "source": "Good.\\,\\,\\, For 125 real money\\,\\, I can surgically remove the wort growths\\,\\,\\,, granting you some extra time.", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/52", "kind": "dialogue", "conv": 31, "entry": 52, "source": "I don't have that much...", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/53", "kind": "dialogue", "conv": 31, "entry": 53, "source": "Proceed.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/31/54", "kind": "dialogue", "conv": 31, "entry": 54, "source": "Not.\\, Without.\\, Money.\\,", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/55", "kind": "dialogue", "conv": 31, "entry": 55, "source": "Okay\\,\\,\\,, this will hurt!", "target": "", "status": "todo", "context": "Unused/Doctor | Doctor"},
    {"id": "dlg/31/56", "kind": "dialogue", "conv": 31, "entry": 56, "source": "I'm back for the surgery.", "target": "", "status": "todo", "context": "Unused/Doctor | Player"},
    {"id": "dlg/61/1", "kind": "dialogue", "conv": 61, "entry": 1, "source": "Hello there!\\,\\, You\\, look something\\, I've been looking for!\\,\\,\\, Maybe\\, you would be interested about my\\, little...\\,\\, game.\\,\\, It has a high prize\\, if you manage to solve\\, this little...\\,\\, puzzle.\\,\\, It doesn't cost anything!\\,\\, It's completely free!", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Emilie Palmer"},
    {"id": "dlg/61/2", "kind": "dialogue", "conv": 61, "entry": 2, "source": "I have to go. (Leave)", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/3", "kind": "dialogue", "conv": 61, "entry": 3, "source": "Who are you?", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/4", "kind": "dialogue", "conv": 61, "entry": 4, "source": "Puzzle? Tell me more.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/5", "kind": "dialogue", "conv": 61, "entry": 5, "source": "Okay\\, okay...\\,\\, so...\\,\\, can you\\, hear that sound?\\,\\, Listen carefully.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Emilie Palmer"},
    {"id": "dlg/61/6", "kind": "dialogue", "conv": 61, "entry": 6, "source": "Me?\\,\\, Um...\\,\\, I'm an artist.\\, Modern art.\\,\\, I like to use colors.\\,\\, Lots of colors...\\,\\, ", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Emilie Palmer"},
    {"id": "dlg/61/7", "kind": "dialogue", "conv": 61, "entry": 7, "source": "Those drunk people?", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/8", "kind": "dialogue", "conv": 61, "entry": 8, "source": "I can hear some breathing.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/9", "kind": "dialogue", "conv": 61, "entry": 9, "source": "I hear some weird radio sounds.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/10", "kind": "dialogue", "conv": 61, "entry": 10, "source": "Nope. I can't hear anything unusual.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/12", "kind": "dialogue", "conv": 61, "entry": 12, "source": "Exactly!\\,\\, Yes!\\, Take these keys...\\,\\, that was the easiest part.\\,\\, Next\\, you have to go to the apartment\\, which is on the second floor.\\,\\, There you have to solve\\, the puzzle\\,\\, which I made for\\, people like you...\\,\\, don't steal anything.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Emilie Palmer"},
    {"id": "dlg/61/13", "kind": "dialogue", "conv": 61, "entry": 13, "source": "Okay... then what?", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/15", "kind": "dialogue", "conv": 61, "entry": 15, "source": "Oh...\\,\\, so you can't hear that.\\,\\, I'm\\, sorry that\\, I wasted your time. ", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Emilie Palmer"},
    {"id": "dlg/61/16", "kind": "dialogue", "conv": 61, "entry": 16, "source": "Why are you doing this?", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/17", "kind": "dialogue", "conv": 61, "entry": 17, "source": "I'm not sure about this...", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
    {"id": "dlg/61/18", "kind": "dialogue", "conv": 61, "entry": 18, "source": "You'll see... there is one door with two question marks. You just have to get it open and inside... well... there is the prize! Remember to follow the instructions! Don't do anything else.", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Emilie Palmer"},
    {"id": "dlg/61/21", "kind": "dialogue", "conv": 61, "entry": 21, "source": "What is the prize?", "target": "", "status": "todo", "context": "Unused/Emilie Palmer | Player"},
