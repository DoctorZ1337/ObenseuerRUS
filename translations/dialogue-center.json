    {"id": "dlg/66/121", "kind": "dialogue", "conv": 66, "entry": 121, "source": "Select other floor.", "target": "Выбрать другой этаж.", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/122", "kind": "dialogue", "conv": 66, "entry": 122, "source": "Select other floor.", "target": "Выбрать другой этаж.", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/123", "kind": "dialogue", "conv": 66, "entry": 123, "source": "I'm [lua(Variable[\"PlayerFirstName\"])] [lua(Variable[\"PlayerLastName\"])]", "target": "Это [lua(Variable[\"PlayerFirstName\"])] [lua(Variable[\"PlayerLastName\"])].", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/124", "kind": "dialogue", "conv": 66, "entry": 124, "source": "[lua(Variable[\"PlayerFirstName\"])]...\\,\\, I\\, don't know you.\\,\\, What do you want?\\,\\, I hope you're not one of those mushroom sellers.", "target": "[lua(Variable[\"PlayerFirstName\"])]...\\,\\, Я\\, тебя не знаю.\\,\\, Чего тебе?\\,\\, Надеюсь, ты не из этих торговцев грибами.", "status": "translated", "context": "Center/Doorphone: Osmo | Doorphone"},
    {"id": "dlg/66/125", "kind": "dialogue", "conv": 66, "entry": 125, "source": "Yeah, I sell mushrooms", "target": "Ага, продаю грибы.", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/128", "kind": "dialogue", "conv": 66, "entry": 128, "source": "Sorry, wrong address (Leave)", "target": "Простите, не тот адрес. (Уйти)", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/129", "kind": "dialogue", "conv": 66, "entry": 129, "source": "Then I ask you to leave.\\,\\, I'm not going to buy any mushrooms\\,, radios\\, or whatever you want to sell.\\,\\, I stopped using those\\, and I feel better than ever now!\\,\\, Try someone else!", "target": "Тогда прошу уйти.\\,\\, Я не собираюсь покупать ни грибы\\,, ни радио\\,, ни что там ещё у тебя на продажу.\\,\\, Я больше этим не пользуюсь\\, и чувствую себя лучше, чем когда-либо!\\,\\, Попытай счастья у других!", "status": "translated", "context": "Center/Doorphone: Osmo | Doorphone"},
    {"id": "dlg/66/130", "kind": "dialogue", "conv": 66, "entry": 130, "source": "I'm [lua(Variable[\"PlayerFirstName\"])] [lua(Variable[\"PlayerLastName\"])]", "target": "Это [lua(Variable[\"PlayerFirstName\"])] [lua(Variable[\"PlayerLastName\"])].", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/131", "kind": "dialogue", "conv": 66, "entry": 131, "source": "So?\\,\\, What do you want?", "target": "Ну?\\,\\, Чего тебе?", "status": "translated", "context": "Center/Doorphone: Osmo | Doorphone"},
    {"id": "dlg/66/132", "kind": "dialogue", "conv": 66, "entry": 132, "source": "I want to get in", "target": "Хочу войти.", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/133", "kind": "dialogue", "conv": 66, "entry": 133, "source": "I'm selling something", "target": "Кое-что продаю.", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/135", "kind": "dialogue", "conv": 66, "entry": 135, "source": "Sorry, wrong address (Leave)", "target": "Простите, не тот адрес. (Уйти)", "status": "translated", "context": "Center/Doorphone: Osmo | Player"},
    {"id": "dlg/66/136", "kind": "dialogue", "conv": 66, "entry": 136, "source": "And why would I do that?\\,\\, I have no fucking idea\\, who you are.\\,\\, I'm not going to let in some\\, [lua(Variable[\"PlayerFirstName\"])]\\, I have never met before.\\,\\, So I ask you to leave...\\,\\, right now!", "target": "И с чего бы?\\,\\, Я, блин, понятия не имею\\,, кто ты.\\,\\, Не стану я впускать незнакомцев вроде\\, [lua(Variable[\"PlayerFirstName\"])]\\,, кого вижу впервые.\\,\\, Так что прошу уйти...\\,\\, прямо сейчас!", "status": "translated", "context": "Center/Doorphone: Osmo | Doorphone"},
    {"id": "dlg/66/137", "kind": "dialogue", "conv": 66, "entry": 137, "source": "Oh... okay. What are you selling?", "target": "А... ладно. Что продаёшь?", "status": "translated", "context": "Center/Doorphone: Osmo | Doorphone"}
  ]
}
