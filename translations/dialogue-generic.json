  "entries": [
    {"id": "dlg/116/1", "kind": "dialogue", "conv": 116, "entry": 1, "source": "Hands... off!", "target": "Руки.. прочь!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/2", "kind": "dialogue", "conv": 116, "entry": 2, "source": "Hey!", "target": "Эй!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/3", "kind": "dialogue", "conv": 116, "entry": 3, "source": "Damn it!", "target": "Чёрт!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/4", "kind": "dialogue", "conv": 116, "entry": 4, "source": "I'm going to report you.", "target": "Я на тебя заявлю.", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/5", "kind": "dialogue", "conv": 116, "entry": 5, "source": "I saw what you did there!", "target": "Я вижу, что ты творишь!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/6", "kind": "dialogue", "conv": 116, "entry": 6, "source": "STOP!", "target": "СТОЙ!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/7", "kind": "dialogue", "conv": 116, "entry": 7, "source": "What did you do?", "target": "Что это было?!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/8", "kind": "dialogue", "conv": 116, "entry": 8, "source": "Can't have shit in Open Sewer.", "target": "В Открытой Клоаке ничего нельзя оставить.", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/9", "kind": "dialogue", "conv": 116, "entry": 9, "source": "Perkele!", "target": "Perkele!", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/10", "kind": "dialogue", "conv": 116, "entry": 10, "source": "Soon you'll get to explain yourself to the police.", "target": "Скоро будешь объясняться с полицией.", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/116/11", "kind": "dialogue", "conv": 116, "entry": 11, "source": "What are you doing?", "target": "Ты что делаешь?", "status": "translated", "context": "Generic/Crime | ???"},
    {"id": "dlg/117/2", "kind": "dialogue", "conv": 117, "entry": 2, "source": "Come here.", "target": "Иди сюда.", "status": "translated", "context": "Generic/CrimePolice | ???"},
    {"id": "dlg/117/3", "kind": "dialogue", "conv": 117, "entry": 3, "source": "Your explanation better be good.", "target": "Объяснение лучше бы было убедительным.", "status": "translated", "context": "Generic/CrimePolice | ???"},
    {"id": "dlg/117/4", "kind": "dialogue", "conv": 117, "entry": 4, "source": "I just want to talk!", "target": "Я просто хочу поговорить!", "status": "translated", "context": "Generic/CrimePolice | ???"},
    {"id": "dlg/117/5", "kind": "dialogue", "conv": 117, "entry": 5, "source": "You! Criminal! Come here!", "target": "Ты! Преступник! Иди сюда!", "status": "translated", "context": "Generic/CrimePolice | ???"},
    {"id": "dlg/117/6", "kind": "dialogue", "conv": 117, "entry": 6, "source": "Come with me!", "target": "Пройдём со мной!", "status": "translated", "context": "Generic/CrimePolice | ???"},
    {"id": "dlg/117/7", "kind": "dialogue", "conv": 117, "entry": 7, "source": "Let's visit the precinct.", "target": "Прогуляемся до участка.", "status": "translated", "context": "Generic/CrimePolice | ???"},
    {"id": "dlg/125/1", "kind": "dialogue", "conv": 125, "entry": 1, "source": "Show your permit\\,\\, and identification to the camera.", "target": "Покажите пропуск\\,\\, и удостоверение личности в камеру.", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | ???"},
    {"id": "dlg/125/2", "kind": "dialogue", "conv": 125, "entry": 2, "source": "Just let me out, I shouldn't be here!", "target": "Просто выпустите меня, мне здесь не место!", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | Player"},
    {"id": "dlg/125/3", "kind": "dialogue", "conv": 125, "entry": 3, "source": "Do you know who I am?", "target": "Вы знаете, кто я?", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | Player"},
    {"id": "dlg/125/4", "kind": "dialogue", "conv": 125, "entry": 4, "source": "I lost them", "target": "Они потерялись", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | Player"},
    {"id": "dlg/125/5", "kind": "dialogue", "conv": 125, "entry": 5, "source": "I can't help you\\,\\,, sorry.", "target": "Ничем не могу помочь\\,\\,, извините.", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | ???"},
    {"id": "dlg/125/6", "kind": "dialogue", "conv": 125, "entry": 6, "source": "No\\,\\,, and that's not my problem.", "target": "Нет\\,\\,, и это не моя проблема.", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | ???"},
    {"id": "dlg/125/7", "kind": "dialogue", "conv": 125, "entry": 7, "source": "No\\,\\,, and I'm not the one to decide that.", "target": "Нет\\,\\,, и решать это не мне.", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | ???"},
    {"id": "dlg/125/8", "kind": "dialogue", "conv": 125, "entry": 8, "source": "(Leave)", "target": "(Уйти)", "status": "translated", "context": "Generic/Doorphone/ExternalBorder | Player"},
    {"id": "dlg/157/1", "kind": "dialogue", "conv": 157, "entry": 1, "source": "Can you just leave?", "target": "Может, просто уйдёшь?", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/2", "kind": "dialogue", "conv": 157, "entry": 2, "source": "Can't I be at peace anywhere?", "target": "Неужели нигде нельзя побыть в покое?", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/3", "kind": "dialogue", "conv": 157, "entry": 3, "source": "Fuck off!", "target": "Отвали!", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/4", "kind": "dialogue", "conv": 157, "entry": 4, "source": "What is this terrible noise?", "target": "Что это за жуткий шум?", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/5", "kind": "dialogue", "conv": 157, "entry": 5, "source": "Awful!", "target": "Ужасно!", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/6", "kind": "dialogue", "conv": 157, "entry": 6, "source": "What kind of musician do you think you are?", "target": "Да какой ты, к чёрту, музыкант?", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/7", "kind": "dialogue", "conv": 157, "entry": 7, "source": "Terrible... absolutely terrible.", "target": "Ужасно... просто ужасно.", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/8", "kind": "dialogue", "conv": 157, "entry": 8, "source": "Can you stop that?", "target": "Может, хватит?", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/9", "kind": "dialogue", "conv": 157, "entry": 9, "source": "Ugh... my ears hurt.", "target": "Ох... уши болят.", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/157/10", "kind": "dialogue", "conv": 157, "entry": 10, "source": "What is this horrible music?", "target": "Что это за кошмарная музыка?", "status": "translated", "context": "Generic/Guitar/Guitar Negative | ???"},
    {"id": "dlg/158/1", "kind": "dialogue", "conv": 158, "entry": 1, "source": "Eh... take the coin.", "target": "Эх... держи монету.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/2", "kind": "dialogue", "conv": 158, "entry": 2, "source": "You can play almost as well as my friend.", "target": "Играешь почти так же хорошо, как мой друг.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/3", "kind": "dialogue", "conv": 158, "entry": 3, "source": "That's good.", "target": "Неплохо.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/4", "kind": "dialogue", "conv": 158, "entry": 4, "source": "Here's some money for you.", "target": "Вот тебе немного денег.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/5", "kind": "dialogue", "conv": 158, "entry": 5, "source": "Well, now that sounds great!", "target": "Вот это звучит здорово!", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/6", "kind": "dialogue", "conv": 158, "entry": 6, "source": "That sounds okay.", "target": "Сойдёт.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/7", "kind": "dialogue", "conv": 158, "entry": 7, "source": "Just take the money and disappear.", "target": "Просто возьми деньги и исчезни.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/8", "kind": "dialogue", "conv": 158, "entry": 8, "source": "Reminds me of my grandmother's music. Take this.", "target": "Напоминает музыку моей бабушки. Держи.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/9", "kind": "dialogue", "conv": 158, "entry": 9, "source": "Here's money for you.", "target": "Вот тебе деньги.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/158/10", "kind": "dialogue", "conv": 158, "entry": 10, "source": "Not bad at all! Take this.", "target": "Совсем неплохо! Держи.", "status": "translated", "context": "Generic/Guitar/Guitar Positive | ???"},
    {"id": "dlg/120/1", "kind": "dialogue", "conv": 120, "entry": 1, "source": "Hey! You're not allowed here!", "target": "Эй! Сюда нельзя!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/2", "kind": "dialogue", "conv": 120, "entry": 2, "source": "For your own safety, you should go!", "target": "Ради твоей же безопасности — уходи!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/3", "kind": "dialogue", "conv": 120, "entry": 3, "source": "I don't tolerate trespassers! You should leave now!", "target": "Я не терплю нарушителей! Убирайся сейчас же!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/4", "kind": "dialogue", "conv": 120, "entry": 4, "source": "Can you please leave? This is a private area!", "target": "Пожалуйста, уйди! Это частная территория!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/5", "kind": "dialogue", "conv": 120, "entry": 5, "source": "You're trespassing! Leave now or I'll call the authorities!", "target": "Ты нарушаешь границы! Уходи сейчас же, или я вызову власти!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/6", "kind": "dialogue", "conv": 120, "entry": 6, "source": "This area's off-limits!", "target": "Сюда вход запрещён!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/7", "kind": "dialogue", "conv": 120, "entry": 7, "source": "This is a private area!", "target": "Это частная территория!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/8", "kind": "dialogue", "conv": 120, "entry": 8, "source": "Excuse me, this is private property. Please leave.", "target": "Простите, это частная собственность. Пожалуйста, уйдите.", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/9", "kind": "dialogue", "conv": 120, "entry": 9, "source": "You have no business here! Leave!", "target": "Тебе здесь нечего делать! Уходи!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/10", "kind": "dialogue", "conv": 120, "entry": 10, "source": "You shouldn't be here! Go away!", "target": "Тебе здесь не место! Проваливай!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/120/11", "kind": "dialogue", "conv": 120, "entry": 11, "source": "Leave now!", "target": "Уходи немедленно!", "status": "translated", "context": "Generic/Trespassing | ???"},
    {"id": "dlg/220/1", "kind": "dialogue", "conv": 220, "entry": 1, "source": "The total amount is [lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])].", "target": "Итого к оплате [lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])].", "status": "translated", "context": "Generic/Cashier | ???"},
    {"id": "dlg/220/2", "kind": "dialogue", "conv": 220, "entry": 2, "source": "That comes to [lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])].", "target": "С вас [lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])].", "status": "translated", "context": "Generic/Cashier | ???"},
    {"id": "dlg/220/3", "kind": "dialogue", "conv": 220, "entry": 3, "source": "[lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])], please.", "target": "[lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])], пожалуйста.", "status": "translated", "context": "Generic/Cashier | ???"},
    {"id": "dlg/220/4", "kind": "dialogue", "conv": 220, "entry": 4, "source": "Your total is [lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])].", "target": "Всего [lua(Variable[\"Price\"])] [lua(Variable[\"Currency\"])].", "status": "translated", "context": "Generic/Cashier | ???"},
    {"id": "dlg/231/1", "kind": "dialogue", "conv": 231, "entry": 1, "source": "What the hell!", "target": "Какого чёрта!", "status": "translated", "context": "Generic/Animal Kill Negative | ???"},
    {"id": "dlg/231/2", "kind": "dialogue", "conv": 231, "entry": 2, "source": "You’re going to pay for this!", "target": "Ты за это заплатишь!", "status": "translated", "context": "Generic/Animal Kill Negative | ???"},
    {"id": "dlg/231/3", "kind": "dialogue", "conv": 231, "entry": 3, "source": "How could you be so cruel?", "target": "Откуда такая жестокость?", "status": "translated", "context": "Generic/Animal Kill Negative | ???"},
    {"id": "dlg/231/4", "kind": "dialogue", "conv": 231, "entry": 4, "source": "What did you do to that poor creature!", "target": "Зачем ты так с этим бедным созданием!", "status": "translated", "context": "Generic/Animal Kill Negative | ???"},
    {"id": "dlg/231/5", "kind": "dialogue", "conv": 231, "entry": 5, "source": "I hope you’re ready for the curse that’ll come your way!", "target": "Жди проклятия — оно тебя настигнет!", "status": "translated", "context": "Generic/Animal Kill Negative | ???"},
    {"id": "dlg/231/6", "kind": "dialogue", "conv": 231, "entry": 6, "source": "What kind of monster kills a harmless creature like that?", "target": "Какое чудовище убивает такое безобидное существо?", "status": "translated", "context": "Generic/Animal Kill Negative | ???"},
    {"id": "dlg/233/1", "kind": "dialogue", "conv": 233, "entry": 1, "source": "You’re not welcome here anymore!", "target": "Тебе здесь больше не рады!", "status": "translated", "context": "Generic/Not Selling | ???"},
    {"id": "dlg/233/2", "kind": "dialogue", "conv": 233, "entry": 2, "source": "I’m not selling you anything!", "target": "Я тебе ничего не продам!", "status": "translated", "context": "Generic/Not Selling | ???"},
    {"id": "dlg/233/3", "kind": "dialogue", "conv": 233, "entry": 3, "source": "I don’t serve people like you!", "target": "Таких, как ты, я не обслуживаю!", "status": "translated", "context": "Generic/Not Selling | ???"},
    {"id": "dlg/233/4", "kind": "dialogue", "conv": 233, "entry": 4, "source": "Take your money elsewhere!", "target": "Неси свои деньги в другое место!", "status": "translated", "context": "Generic/Not Selling | ???"},
    {"id": "dlg/233/5", "kind": "dialogue", "conv": 233, "entry": 5, "source": "I have no interest in selling to you.", "target": "У меня нет никакого желания тебе что-то продавать.", "status": "translated", "context": "Generic/Not Selling | ???"},
    {"id": "dlg/248/1", "kind": "dialogue", "conv": 248, "entry": 1, "source": "What the fuck!?", "target": "Какого хрена!?", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/2", "kind": "dialogue", "conv": 248, "entry": 2, "source": "Ow! What the hell?", "target": "Ай! Какого чёрта?", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/3", "kind": "dialogue", "conv": 248, "entry": 3, "source": "Somebody, help me!", "target": "Кто-нибудь, помогите!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/4", "kind": "dialogue", "conv": 248, "entry": 4, "source": "HELP!", "target": "ПОМОГИТЕ!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/5", "kind": "dialogue", "conv": 248, "entry": 5, "source": "AAAH! What are you doing?!", "target": "А-А-А! Ты что творишь?!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/6", "kind": "dialogue", "conv": 248, "entry": 6, "source": "Can’t even exist in Open Sewer.", "target": "В Открытой Клоаке даже просто существовать нельзя.", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/7", "kind": "dialogue", "conv": 248, "entry": 7, "source": "Help! Police!", "target": "Помогите! Полиция!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/8", "kind": "dialogue", "conv": 248, "entry": 8, "source": "That hurts!", "target": "Больно же!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/9", "kind": "dialogue", "conv": 248, "entry": 9, "source": "Why?! I did nothing to you!", "target": "За что?! Я же тебе ничего не делаю!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/248/10", "kind": "dialogue", "conv": 248, "entry": 10, "source": "STOP!", "target": "СТОЙ!", "status": "translated", "context": "Generic/Hit | ???"},
    {"id": "dlg/259/1", "kind": "dialogue", "conv": 259, "entry": 1, "source": "Big mistake. You're coming with me.", "target": "Большая ошибка. Пройдёшь со мной.", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/2", "kind": "dialogue", "conv": 259, "entry": 2, "source": "You think you can get away with that?", "target": "Думаешь, тебе это сойдёт с рук?", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/3", "kind": "dialogue", "conv": 259, "entry": 3, "source": "You just bought yourself a long stay behind bars!", "target": "Теперь тебя ждёт долгий срок за решёткой!", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/4", "kind": "dialogue", "conv": 259, "entry": 4, "source": "You just made a serious mistake. You're going to jail.", "target": "Это серьёзная ошибка. Поедешь в тюрьму.", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/5", "kind": "dialogue", "conv": 259, "entry": 5, "source": "You're gonna regret that!", "target": "Ты об этом пожалеешь!", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/6", "kind": "dialogue", "conv": 259, "entry": 6, "source": "Oh, you're done now.", "target": "О, теперь тебе конец.", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/7", "kind": "dialogue", "conv": 259, "entry": 7, "source": "You're coming with me!", "target": "Пройдёшь со мной!", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/8", "kind": "dialogue", "conv": 259, "entry": 8, "source": "That was your last mistake!", "target": "Это была твоя последняя ошибка!", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/9", "kind": "dialogue", "conv": 259, "entry": 9, "source": "You just made your bad day worse.", "target": "Плохой день у тебя только что стал ещё хуже.", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/259/10", "kind": "dialogue", "conv": 259, "entry": 10, "source": "You’re going down for this!", "target": "Ты за это сядешь!", "status": "translated", "context": "Generic/Hit Police | ???"},
    {"id": "dlg/266/1", "kind": "dialogue", "conv": 266, "entry": 1, "source": "You wanna play?\\,\\, Take\\, a seat.", "target": "Хочешь сыграть?\\,\\, Садись\\, за стол.", "status": "translated", "context": "Generic/Card Games/Invite | ???"},
    {"id": "dlg/267/2", "kind": "dialogue", "conv": 267, "entry": 2, "source": "Let's play Shittypants", "target": "Давай сыграем в «Обосранные штаны»", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/3", "kind": "dialogue", "conv": 267, "entry": 3, "source": "Let's play Crosseven", "target": "Давай сыграем в «Крестовую семёрку»", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/5", "kind": "dialogue", "conv": 267, "entry": 5, "source": "So\\,\\,, you wanna\\, play?", "target": "Ну что\\,\\,, хочешь\\, сыграть?", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/6", "kind": "dialogue", "conv": 267, "entry": 6, "source": "Have you\\, ever played\\, Crosseven\\, or...\\,\\, Shittypants?", "target": "Доводилось\\, играть\\, в «Крестовую семёрку»\\, или...\\,\\, в «Обосранные штаны»?", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/7", "kind": "dialogue", "conv": 267, "entry": 7, "source": "Yeah, I have played both", "target": "Да, приходилось играть в обе", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/8", "kind": "dialogue", "conv": 267, "entry": 8, "source": "I haven't played either one", "target": "Не доводилось играть ни в одну", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/9", "kind": "dialogue", "conv": 267, "entry": 9, "source": "Yeah, I have played Crosseven", "target": "Да, в «Крестовую семёрку» играть приходилось", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/10", "kind": "dialogue", "conv": 267, "entry": 10, "source": "I have only played Shittypants", "target": "Приходилось играть только в «Обосранные штаны»", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/11", "kind": "dialogue", "conv": 267, "entry": 11, "source": "Don’t worry\\,\\,, we’ll\\, explain everything!", "target": "Не волнуйся\\,\\,, мы\\, всё объясним!", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/13", "kind": "dialogue", "conv": 267, "entry": 13, "source": "So\\,\\,, maybe\\, we should play\\, Crosseven!", "target": "Тогда\\,\\,, может\\, сыграем\\, в «Крестовую семёрку»!", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/14", "kind": "dialogue", "conv": 267, "entry": 14, "source": "Yeah, let's play Crosseven", "target": "Да, давай сыграем в «Крестовую семёрку»", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/15", "kind": "dialogue", "conv": 267, "entry": 15, "source": "I want to play Shittypants", "target": "Хочу сыграть в «Обосранные штаны»", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/16", "kind": "dialogue", "conv": 267, "entry": 16, "source": "Never mind, I can’t play right now (Leave)", "target": "Неважно, сейчас не могу играть (Уйти)", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/17", "kind": "dialogue", "conv": 267, "entry": 17, "source": "Great!\\,\\, Which one should we\\, play?", "target": "Отлично!\\,\\, В какую\\, сыграем?", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/18", "kind": "dialogue", "conv": 267, "entry": 18, "source": "Great!", "target": "Отлично!", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/19", "kind": "dialogue", "conv": 267, "entry": 19, "source": "Let's play it then!", "target": "Тогда давай сыграем!", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/21", "kind": "dialogue", "conv": 267, "entry": 21, "source": "Oh\\,\\,, really?\\,\\, Great!", "target": "О\\,\\,, правда?\\,\\, Отлично!", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/22", "kind": "dialogue", "conv": 267, "entry": 22, "source": "Let's play it then!", "target": "Тогда давай сыграем!", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/23", "kind": "dialogue", "conv": 267, "entry": 23, "source": "Yeah, let's play Shittypants", "target": "Да, давай сыграем в «Обосранные штаны»", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/24", "kind": "dialogue", "conv": 267, "entry": 24, "source": "I want to play Crosseven!", "target": "Хочу сыграть в «Крестовую семёрку»!", "status": "translated", "context": "Generic/Card Games/Choose Game First | Player"},
    {"id": "dlg/267/25", "kind": "dialogue", "conv": 267, "entry": 25, "source": "You're ready to play?", "target": "Играем?", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/27", "kind": "dialogue", "conv": 267, "entry": 27, "source": "Ready to play?", "target": "Ну что, сыграем?", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/28", "kind": "dialogue", "conv": 267, "entry": 28, "source": "What do you want to play?", "target": "Во что хочешь сыграть?", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/267/29", "kind": "dialogue", "conv": 267, "entry": 29, "source": "Crosseven’s\\, all about\\, skill\\, and strategy\\,\\,, while Shittypants…\\,\\, well\\,\\,, that one’s pure chaos.", "target": "В «Крестовой семёрке»\\, всё решают\\, умение\\, и стратегия\\,\\,, а «Обосранные штаны»…\\,\\, ну\\,\\,, там сплошной хаос.", "status": "translated", "context": "Generic/Card Games/Choose Game First | ???"},
    {"id": "dlg/268/2", "kind": "dialogue", "conv": 268, "entry": 2, "source": "Beginner's luck...", "target": "Новичкам везёт...", "status": "translated", "context": "Generic/Card Games/Player Ends On Win | Police"},
    {"id": "dlg/268/3", "kind": "dialogue", "conv": 268, "entry": 3, "source": "Whatever...", "target": "Да как скажешь...", "status": "translated", "context": "Generic/Card Games/Player Ends On Win | Police"},
    {"id": "dlg/268/4", "kind": "dialogue", "conv": 268, "entry": 4, "source": "Mmrgh... Rigged game...", "target": "Мммргх... Игра подстроена...", "status": "translated", "context": "Generic/Card Games/Player Ends On Win | Police"},
    {"id": "dlg/268/5", "kind": "dialogue", "conv": 268, "entry": 5, "source": "Lucky you...", "target": "Повезло тебе...", "status": "translated", "context": "Generic/Card Games/Player Ends On Win | Police"},
    {"id": "dlg/269/1", "kind": "dialogue", "conv": 269, "entry": 1, "source": "Better luck next time!", "target": "В следующий раз повезёт!", "status": "translated", "context": "Generic/Card Games/Player Ends On Loss | ???"},
    {"id": "dlg/269/2", "kind": "dialogue", "conv": 269, "entry": 2, "source": "Not so easy, was it?", "target": "Не так-то просто, правда?", "status": "translated", "context": "Generic/Card Games/Player Ends On Loss | ???"},
    {"id": "dlg/269/3", "kind": "dialogue", "conv": 269, "entry": 3, "source": "Thanks for the pocket money.", "target": "Спасибо за карманные деньги.", "status": "translated", "context": "Generic/Card Games/Player Ends On Loss | ???"},
    {"id": "dlg/269/4", "kind": "dialogue", "conv": 269, "entry": 4, "source": "Thanks for your donation!", "target": "Спасибо за пожертвование!", "status": "translated", "context": "Generic/Card Games/Player Ends On Loss | ???"},
    {"id": "dlg/269/5", "kind": "dialogue", "conv": 269, "entry": 5, "source": "It happens...", "target": "Бывает...", "status": "translated", "context": "Generic/Card Games/Player Ends On Loss | ???"},
    {"id": "dlg/269/6", "kind": "dialogue", "conv": 269, "entry": 6, "source": "That was fun, was it not?", "target": "Весело было, правда?", "status": "translated", "context": "Generic/Card Games/Player Ends On Loss | ???"},
    {"id": "dlg/271/1", "kind": "dialogue", "conv": 271, "entry": 1, "source": "Can I get a card?", "target": "Можно мне карту?", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/2", "kind": "dialogue", "conv": 271, "entry": 2, "source": "I need a card...", "target": "Мне нужна карта...", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/3", "kind": "dialogue", "conv": 271, "entry": 3, "source": "A card please?", "target": "Карту, пожалуйста?", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/4", "kind": "dialogue", "conv": 271, "entry": 4, "source": "Can you share?", "target": "Не поделишься?", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/5", "kind": "dialogue", "conv": 271, "entry": 5, "source": "I'll need a card from you.", "target": "Мне нужна от тебя карта.", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/6", "kind": "dialogue", "conv": 271, "entry": 6, "source": "Please...?", "target": "Ну пожалуйста...?", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/7", "kind": "dialogue", "conv": 271, "entry": 7, "source": "I can't play... Give me something.", "target": "Мне нечем ходить... Дай хоть что-нибудь.", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/271/8", "kind": "dialogue", "conv": 271, "entry": 8, "source": "Give me a card...", "target": "Дай мне карту...", "status": "translated", "context": "Generic/Card Games/Request Card | "},
    {"id": "dlg/272/1", "kind": "dialogue", "conv": 272, "entry": 1, "source": "Ugh, come on...", "target": "Ну ёлки, давай же...", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/2", "kind": "dialogue", "conv": 272, "entry": 2, "source": "Damn it...", "target": "Чёрт возьми...", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/3", "kind": "dialogue", "conv": 272, "entry": 3, "source": "Fuck this...", "target": "Да пошло оно всё...", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/4", "kind": "dialogue", "conv": 272, "entry": 4, "source": "This is ridiculous.", "target": "Это просто смешно.", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/5", "kind": "dialogue", "conv": 272, "entry": 5, "source": "God damn it.", "target": "Будь оно всё проклято.", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/6", "kind": "dialogue", "conv": 272, "entry": 6, "source": "Ugh...", "target": "Тьфу...", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/7", "kind": "dialogue", "conv": 272, "entry": 7, "source": "Who shuffled these cards?", "target": "Кто тасовал эти карты?", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/272/8", "kind": "dialogue", "conv": 272, "entry": 8, "source": "My shitty luck...", "target": "Моё дерьмовое везение...", "status": "translated", "context": "Generic/Card Games/Swear | "},
    {"id": "dlg/273/9", "kind": "dialogue", "conv": 273, "entry": 9, "source": "Want to play another game?", "target": "Сыграем ещё партию?", "status": "translated", "context": "Generic/Card Games/Choose Game Retry | ???"},
    {"id": "dlg/273/10", "kind": "dialogue", "conv": 273, "entry": 10, "source": "I've had enough, thanks (Get up)", "target": "С меня хватит, спасибо (Встать)", "status": "translated", "context": "Generic/Card Games/Choose Game Retry | Player"},
    {"id": "dlg/273/11", "kind": "dialogue", "conv": 273, "entry": 11, "source": "I'll play one more game of Crosseven (Continue)", "target": "Сыграю ещё партию в «Крестовую семёрку» (Продолжить)", "status": "translated", "context": "Generic/Card Games/Choose Game Retry | Player"},
    {"id": "dlg/273/12", "kind": "dialogue", "conv": 273, "entry": 12, "source": "I'll play one more game of Shittypants (Continue)", "target": "Сыграю ещё партию в «Обосранные штаны» (Продолжить)", "status": "translated", "context": "Generic/Card Games/Choose Game Retry | Player"},
    {"id": "dlg/285/1", "kind": "dialogue", "conv": 285, "entry": 1, "source": "Crosseven, or Ristiseiska, is the Finnish version of the card game Sevens, where you have to get rid of all your cards.", "target": "«Крестовая семёрка», или Ristiseiska, — финский вариант карточной игры «Севены», где нужно избавиться от всех своих карт.", "status": "translated", "context": "Generic/Card Games/Tutorial Crosseven | ???"},
    {"id": "dlg/285/2", "kind": "dialogue", "conv": 285, "entry": 2, "source": "The player with the 7 of Clubs starts the game.", "target": "Игру начинает тот, у кого семёрка треф.", "status": "translated", "context": "Generic/Card Games/Tutorial Crosseven | ???"},
    {"id": "dlg/332/1", "kind": "dialogue", "conv": 332, "entry": 1, "source": "Oi! You forgot to pay!", "target": "Эй! А заплатить?", "status": "translated", "context": "Generic/Cashier Forgot To Pay | ???"},
    {"id": "dlg/381/1", "kind": "dialogue", "conv": 381, "entry": 1, "source": "Ha! That's what you get for guessing.", "target": "Ха! Вот что бывает, когда гадаешь.", "status": "translated", "context": "Generic/Card Games/Risk Play Failed Welhö | Svana Wallmark"},
    {"id": "dlg/381/2", "kind": "dialogue", "conv": 381, "entry": 2, "source": "Tragic.", "target": "Трагично.", "status": "translated", "context": "Generic/Card Games/Risk Play Failed Welhö | Svana Wallmark"},
    {"id": "dlg/381/3", "kind": "dialogue", "conv": 381, "entry": 3, "source": "The chaos betrays you!", "target": "Хаос тебя предал!", "status": "translated", "context": "Generic/Card Games/Risk Play Failed Welhö | Svana Wallmark"},
    {"id": "dlg/381/4", "kind": "dialogue", "conv": 381, "entry": 4, "source": "Foolishness!", "target": "Глупость!", "status": "translated", "context": "Generic/Card Games/Risk Play Failed Welhö | Svana Wallmark"},
    {"id": "dlg/381/5", "kind": "dialogue", "conv": 381, "entry": 5, "source": "Did the polonium rot your luck?", "target": "Полоний сгноил твою удачу?", "status": "translated", "context": "Generic/Card Games/Risk Play Failed Welhö | Svana Wallmark"},
    {"id": "dlg/395/1", "kind": "dialogue", "conv": 395, "entry": 1, "source": "Pure, chaotic luck!", "target": "Чистая хаотичная удача!", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/395/2", "kind": "dialogue", "conv": 395, "entry": 2, "source": "The shrooms guided your hand!", "target": "Сами грибы направили твою руку!", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/395/3", "kind": "dialogue", "conv": 395, "entry": 3, "source": "Lucky bastard...", "target": "Везёт же некоторым...", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/395/4", "kind": "dialogue", "conv": 395, "entry": 4, "source": "I call nonsense…", "target": "Ерунда какая-то…", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/395/5", "kind": "dialogue", "conv": 395, "entry": 5, "source": "Unbelievable!", "target": "Невероятно!", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/395/6", "kind": "dialogue", "conv": 395, "entry": 6, "source": "A true Welho's intuition!", "target": "Истинное чутьё Welho!", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/395/7", "kind": "dialogue", "conv": 395, "entry": 7, "source": "The chaos rewards your blind faith!", "target": "Хаос вознаграждает твою слепую веру!", "status": "translated", "context": "Generic/Card Games/Risk Play Won Welhö | Matti Kiehinen"},
    {"id": "dlg/420/1", "kind": "dialogue", "conv": 420, "entry": 1, "source": "My mana is depleted!", "target": "Моя мана иссякла!", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/2", "kind": "dialogue", "conv": 420, "entry": 2, "source": "Absolute nonsense!", "target": "Полнейшая чушь!", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/3", "kind": "dialogue", "conv": 420, "entry": 3, "source": "This is absurd!", "target": "Это абсурд!", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/4", "kind": "dialogue", "conv": 420, "entry": 4, "source": "Are these cursed?", "target": "Они что, прокляты?", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/5", "kind": "dialogue", "conv": 420, "entry": 5, "source": "Someone hexed the deck!", "target": "Кто-то сглазил колоду!", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/6", "kind": "dialogue", "conv": 420, "entry": 6, "source": "This cursed game...", "target": "Проклятая игра...", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/7", "kind": "dialogue", "conv": 420, "entry": 7, "source": "Preposterous!", "target": "Нелепость!", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/420/8", "kind": "dialogue", "conv": 420, "entry": 8, "source": "By the red raven!", "target": "Клянусь красным вороном!", "status": "translated", "context": "Generic/Card Games/Swear Welhö | "},
    {"id": "dlg/421/1", "kind": "dialogue", "conv": 421, "entry": 1, "source": "Did you inhale too many spores? Play a card!", "target": "Споры в голову ударили? Ходи!", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/421/2", "kind": "dialogue", "conv": 421, "entry": 2, "source": "Did the shrooms paralyze your brain?", "target": "Грибы парализовали тебе мозг?", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/421/3", "kind": "dialogue", "conv": 421, "entry": 3, "source": "A true Welho acts swiftly!", "target": "Истинный Welho действует быстро!", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/421/4", "kind": "dialogue", "conv": 421, "entry": 4, "source": "Did you fall asleep?", "target": "Спишь, что ли?", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/421/5", "kind": "dialogue", "conv": 421, "entry": 5, "source": "Play a card…", "target": "Ходи…", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/421/6", "kind": "dialogue", "conv": 421, "entry": 6, "source": "Your turn.", "target": "Твой ход.", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/421/7", "kind": "dialogue", "conv": 421, "entry": 7, "source": "Come on...", "target": "Ну давай...", "status": "translated", "context": "Generic/Card Games/Risk Play Hurry Up Welhö | "},
    {"id": "dlg/422/1", "kind": "dialogue", "conv": 422, "entry": 1, "source": "Let the chaos begin!", "target": "Да начнётся хаос!", "status": "translated", "context": "Generic/Card Games/Risk Play Game Start Welhö | "},
    {"id": "dlg/423/1", "kind": "dialogue", "conv": 423, "entry": 1, "source": "Ha!", "target": "Ха!", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/2", "kind": "dialogue", "conv": 423, "entry": 2, "source": "Take them all!", "target": "Забирай все!", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/3", "kind": "dialogue", "conv": 423, "entry": 3, "source": "A heavy burden!", "target": "Тяжкое бремя!", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/4", "kind": "dialogue", "conv": 423, "entry": 4, "source": "Scoop them up!", "target": "Сгребай их!", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/5", "kind": "dialogue", "conv": 423, "entry": 5, "source": "Oh... the shrooms...", "target": "О... грибы...", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/6", "kind": "dialogue", "conv": 423, "entry": 6, "source": "So many cards...", "target": "Сколько карт...", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/7", "kind": "dialogue", "conv": 423, "entry": 7, "source": "You collect garbage like a goblin!", "target": "Собираешь мусор, как гоблин!", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/8", "kind": "dialogue", "conv": 423, "entry": 8, "source": "Are you starting a collection?", "target": "Коллекцию собираешь?", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/423/9", "kind": "dialogue", "conv": 423, "entry": 9, "source": "Oh... the chaos...", "target": "О... хаос...", "status": "translated", "context": "Generic/Card Games/Opponent Picks Up The Pile Welhö | "},
    {"id": "dlg/483/1", "kind": "dialogue", "conv": 483, "entry": 1, "source": "Disgusting!", "target": "Отвратительно!", "status": "translated", "context": "Generic/Soiled Pants | ???"},
    {"id": "dlg/483/2", "kind": "dialogue", "conv": 483, "entry": 2, "source": "Ugh... the smell!", "target": "Фу... ну и вонь!", "status": "translated", "context": "Generic/Soiled Pants | ???"},
    {"id": "dlg/483/3", "kind": "dialogue", "conv": 483, "entry": 3, "source": "What the hell?!", "target": "Какого чёрта?!", "status": "translated", "context": "Generic/Soiled Pants | ???"},
    {"id": "dlg/483/4", "kind": "dialogue", "conv": 483, "entry": 4, "source": "What the turnip is that smell?", "target": "Чем, репа его дери, так воняет?", "status": "translated", "context": "Generic/Soiled Pants | ???"},
