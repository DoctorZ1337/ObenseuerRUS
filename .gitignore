# Результаты сборки .NET
bin/
obj/

# Python
__pycache__/
*.pyc

# Рабочие данные извлечения и перевода (пакеты, сканы сцен игры, сборка архива) — пересоздаются tools/
build/

# Готовые архивы мода — выкладываются в GitHub Releases
dist/

# Официальный релиз фреймворка: tools/fetch-deps.ps1 скачивает его при сборке
deps/

# Локальный путь к игре (см. Directory.Build.props)
GameDir.user.props
